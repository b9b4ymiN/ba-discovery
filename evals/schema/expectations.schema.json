{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BA Discovery scenario expectations",
  "type": "object",
  "required": ["scenario_id", "expectations"],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "level", "check", "params", "semantic_review"],
        "properties": {
          "criterion": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$"},
          "level": {"enum": ["must-pass", "diagnostic"]},
          "check": {"type": "string", "minLength": 1},
          "params": {"type": "object"},
          "semantic_review": {"type": "boolean"},
          "review_prompt": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
